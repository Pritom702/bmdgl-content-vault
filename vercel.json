{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "{server/**,public/**,data/vault.db,data/thumbs/**,data/media/item-5.mp4,data/media/item-6.mp4}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/files/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/share",
      "destination": "/api/index.js"
    }
  ]
}

