{
  "name": "BMDGL Content Vault",
  "short_name": "BMDGL Vault",
  "description": "Central content repository, inline player & prompt/hook library for Bright Mind Digital Growth Lab.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#0B1F4B",
  "theme_color": "#0B1F4B",
  "icons": [
    {
      "src": "/logo.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}

